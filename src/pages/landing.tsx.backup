const MODULES = [
  { role: 'Super Admin', icon: '👑', color: 'bg-purple-100 text-purple-700', desc: 'Kelola semua tenant, subscription, billing SaaS' },
  { role: 'Admin Gedung', icon: '🏢', color: 'bg-blue-100 text-blue-700', desc: 'Dashboard KPI, aset, users, laporan, alarms' },
  { role: 'TRO / Resepsionis', icon: '🪪', color: 'bg-yellow-100 text-yellow-700', desc: 'Registrasi tamu, QR code, parkir, checkout' },
  { role: 'SPV Teknisi', icon: '👔', color: 'bg-teal-100 text-teal-700', desc: 'Monitor tim, approval WO & material request' },
  { role: 'Teknisi', icon: '👷', color: 'bg-green-100 text-green-700', desc: 'Checklist PM, work order, maintenance history' },
  { role: 'Housekeeping', icon: '🧹', color: 'bg-rose-100 text-rose-700', desc: 'Checklist kebersihan, request material, laporan' },
]

const PLANS = [
  {
    name: 'Starter', price: 'Rp 499rb', per: '/ bulan',
    features: ['1 gedung', '10 user', 'PM + WO + Alarm', 'Visitor management', 'Support email'],
    cta: 'Mulai Gratis 14 Hari', highlight: false,
  },
  {
    name: 'Professional', price: 'Rp 1,299rb', per: '/ bulan',
    features: ['3 gedung', '50 user', 'Semua fitur Starter', 'Billing & Invoice', 'IoT integration', 'Support prioritas'],
    cta: 'Pilih Professional', highlight: true,
    badge: 'Paling Populer',
  },
  {
    name: 'Enterprise', price: 'Custom', per: '',
    features: ['Gedung tidak terbatas', 'User tidak terbatas', 'SLA khusus', 'On-premise option', 'Dedicated support', 'Custom integrasi'],
    cta: 'Hubungi Kami', highlight: false,
