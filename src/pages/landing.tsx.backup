import Head from 'next/head'
import Link from 'next/link'
import { useState, useEffect } from 'react'
import { useRouter } from 'next/router'
import { getCookie } from 'cookies-next'

const NAV_LINKS = [
  { label: 'Fitur', href: '#fitur' },
  { label: 'Modul', href: '#modul' },
  { label: 'Harga', href: '#harga' },
  { label: 'Kontak', href: '#kontak' },
]

const FEATURES = [
  { icon: '🏢', title: 'Multi-Tenant SaaS', desc: 'Kelola banyak gedung & perusahaan dalam satu platform. Isolasi data penuh antar tenant.' },
  { icon: '📱', title: 'Mobile-First Teknisi', desc: 'App mobile PWA untuk teknisi & housekeeping. Offline-ready, checklist, foto langsung dari lapangan.' },
  { icon: '🔧', title: 'Preventive Maintenance', desc: 'Jadwal PM otomatis, template checklist, escalate otomatis jika overdue.' },
  { icon: '⚡', title: 'Realtime Monitoring', desc: 'Dashboard alarm IoT realtime via WebSocket. Notifikasi email otomatis ke PIC.' },
  { icon: '📄', title: 'Billing & Invoice', desc: 'Generate invoice listrik/air tenant otomatis dari data meter. Export siap kirim.' },
  { icon: '🪪', title: 'Visitor Management', desc: 'Registrasi tamu, QR code akses, validasi parkir, log akses per gedung.' },
